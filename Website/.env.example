# Copy to .env on the server. Keep real keys and the instance folder private.
# These settings are optional for local browsing and manual-based chat.
SECRET_KEY=
# Optional absolute private data directory for a host's persistent disk.
TECHVERSE_INSTANCE_DIR=
TECHVERSE_WHATSAPP=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional one-time paid membership through your own Stripe account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Separate one-time price for technician advertising.
STRIPE_TECHNICIAN_PRICE_ID=
PUBLIC_BASE_URL=
# Set on an HTTPS production site only.
HTTPS_ONLY=0
TRUSTED_HOSTS=
HOST=127.0.0.1
PORT=5000
